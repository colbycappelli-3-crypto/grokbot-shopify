# GROKBOT COMMERCE — example environment file.
#
# Copy to `.env` and fill in real values LOCALLY. NEVER commit `.env` or real
# secrets. Every value below is a PLACEHOLDER only. No external service is
# connected in this phase.

# ---- Core LLM / Grok ----
GROK_API_KEY=REPLACE_ME
GROK_API_BASE_URL=https://api.example-not-configured.local

# ---- Runtime (non-secret config) ----
GROKBOT_ENV=development
LOG_LEVEL=info

# ---- Shopify catalog credential (NOT CONNECTED — placeholders only) ----
# Set SHOPIFY_ADMIN_TOKEN and SHOPIFY_STORE_DOMAIN in the process environment
# or in a gitignored .env file on your machine. Do not paste them into chat,
# source code, GitHub, or this committed file. Leave REPLACE_ME here.
# SHOPIFY_ADMIN_TOKEN: Admin API access token, scope read_products only.
# SHOPIFY_STORE_DOMAIN: shop hostname. The app does not read this file.
# EXTERNAL_CONNECTIONS_ENABLED stays false until a later reviewed change
# after explicit human approval. No request is sent to the store.
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET are not used by the catalog read.
SHOPIFY_API_KEY=REPLACE_ME
SHOPIFY_API_SECRET=REPLACE_ME
SHOPIFY_ADMIN_TOKEN=REPLACE_ME
SHOPIFY_STORE_DOMAIN=REPLACE_ME

# ---- Local state store (local-only default; no secret) ----
DATABASE_URL=sqlite:///./local_grokbot_state.db
