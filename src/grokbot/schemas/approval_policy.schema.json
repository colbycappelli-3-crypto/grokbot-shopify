{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbot.commerce/schemas/approval_policy.schema.json",
  "title": "GROKBOT Approval Policy",
  "description": "Owner-editable mapping of action categories to approval classes. The default class is applied when a category is not explicitly listed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_class", "classes", "rules"],
  "properties": {
    "version": { "type": "string" },
    "default_class": {
      "type": "string",
      "enum": ["AUTONOMOUS", "APPROVAL_REQUIRED", "PROHIBITED"],
      "description": "Fail-safe class applied to any unmatched action category."
    },
    "owner_can_override": { "type": "boolean", "default": true },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AUTONOMOUS", "APPROVAL_REQUIRED", "PROHIBITED"],
      "properties": {
        "AUTONOMOUS": { "$ref": "#/$defs/class_def" },
        "APPROVAL_REQUIRED": { "$ref": "#/$defs/class_def" },
        "PROHIBITED": { "$ref": "#/$defs/class_def" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "class_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "class"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "class": {
          "type": "string",
          "enum": ["AUTONOMOUS", "APPROVAL_REQUIRED", "PROHIBITED"]
        },
        "description": { "type": "string" }
      }
    }
  }
}
