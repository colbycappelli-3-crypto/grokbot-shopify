{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbot.commerce/schemas/evidence_record.schema.json",
  "title": "GROKBOT Evidence Record",
  "description": "Provenance record for a claim. Phase 2 records are mock or test data and must say so.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_type",
    "source_reference",
    "claim_supported",
    "collected_by",
    "verification_status",
    "notes"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["mock", "test", "operator_supplied", "unknown"]
    },
    "source_reference": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": ["string", "null"] },
    "claim_supported": { "type": "string", "minLength": 1 },
    "collected_by": { "type": "string", "minLength": 1 },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "unverified", "unknown"]
    },
    "freshness": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
