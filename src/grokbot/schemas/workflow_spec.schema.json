{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbot.commerce/schemas/workflow_spec.schema.json",
  "title": "GROKBOT Workflow Specification",
  "description": "A workflow defines an ordered, dependency-aware set of stages. Stages may be actions performed by agents, validation gates, or human approval gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "division", "description", "stages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "division": {
      "type": "string",
      "enum": ["shared", "print_on_demand", "us_dropshipping", "digital_services"]
    },
    "description": { "type": "string", "minLength": 1 },
    "objective": {
      "type": "string",
      "description": "The type of business objective this workflow serves."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["action", "validation_gate", "approval_gate"]
        },
        "agent": {
          "type": "string",
          "description": "Agent id responsible for an action stage."
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Stage ids that must complete before this stage."
        },
        "permission": {
          "type": "string",
          "enum": ["AUTONOMOUS", "APPROVAL_REQUIRED", "PROHIBITED"],
          "description": "Declared approval class for an action stage."
        },
        "produces": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Named outputs this stage produces for downstream stages."
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criteria", "on_fail"],
          "properties": {
            "criteria": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "on_fail": {
              "type": "string",
              "enum": ["halt", "request_more_research", "escalate", "reject"]
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approver", "description"],
          "properties": {
            "approver": { "type": "string", "enum": ["human_owner"] },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "action" } }, "required": ["type"] },
          "then": { "required": ["agent", "permission"] }
        },
        {
          "if": { "properties": { "type": { "const": "validation_gate" } }, "required": ["type"] },
          "then": { "required": ["validation"] }
        },
        {
          "if": { "properties": { "type": { "const": "approval_gate" } }, "required": ["type"] },
          "then": { "required": ["approval"] }
        }
      ]
    }
  }
}
