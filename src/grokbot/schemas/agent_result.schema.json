{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbot.commerce/schemas/agent_result.schema.json",
  "title": "GROKBOT Agent Result",
  "description": "Structured result returned by a logical agent for one job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "agent_id",
    "status",
    "findings",
    "structured_output",
    "evidence",
    "assumptions",
    "unknowns",
    "confidence",
    "validation_flags",
    "recommended_next_action",
    "errors"
  ],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "findings": { "type": "array", "items": { "type": "object" } },
    "structured_output": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "object" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis", "notes"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "not_applicable"]
        },
        "basis": { "type": "string" },
        "scope": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "validation_flags": { "type": "array", "items": { "type": "string" } },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
