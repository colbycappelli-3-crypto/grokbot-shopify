{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbot.commerce/schemas/connector_result.schema.json",
  "title": "GROKBOT Connector Result",
  "description": "Local result of a read-only connector call. External execution, credential use, and production connection are always false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_id",
    "operation",
    "mode",
    "access",
    "query_id",
    "data_classification",
    "external_actions",
    "network_calls",
    "credentials_used",
    "production_connected",
    "executed",
    "refused",
    "refusal_code",
    "local_read",
    "payload",
    "evidence_records",
    "unknowns",
    "credential_needed",
    "connection_status"
  ],
  "properties": {
    "connector_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string" },
    "mode": { "type": "string", "enum": ["mock", "read_only", "refused"] },
    "access": { "type": "string", "const": "read_only" },
    "query_id": { "type": "string" },
    "data_classification": { "type": "string", "enum": ["TEST_MOCK", "UNKNOWN"] },
    "external_actions": { "type": "array", "maxItems": 0 },
    "network_calls": { "type": "integer", "const": 0 },
    "credentials_used": { "type": "boolean", "const": false },
    "production_connected": { "type": "boolean", "const": false },
    "executed": { "type": "boolean", "const": false },
    "refused": { "type": "boolean" },
    "refusal_code": { "type": ["string", "null"] },
    "local_read": { "type": "boolean" },
    "payload": { "type": ["object", "null"] },
    "evidence_records": { "type": "array", "items": { "type": "object" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "credential_needed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "env_vars": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string" },
        "api": { "type": "string" },
        "method": { "type": "string" },
        "host_placeholder": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "connection_status": { "type": "string", "const": "not_connected" }
  }
}
